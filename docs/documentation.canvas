		{"id":"e3","fromNode":"lvl2","fromSide":"right","toNode":"code","toSide":"left","label":"описывает"},
		{"id":"e4","fromNode":"code","fromSide":"top","toNode":"conflict","toSide":"left","label":"столкновение с реальностью","color":"4"},
		{"id":"e5","fromNode":"conflict","fromSide":"top","toNode":"lvl1","toSide":"right","label":"разрешает только пользователь","color":"2"},
		{"id":"e6","fromNode":"lvl2","fromSide":"top","toNode":"conflict","toSide":"bottom","label":"противоречие","color":"2"}
	]
